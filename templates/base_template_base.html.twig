<!DOCTYPE html>
<html lang="es">

<head>
	<meta charset="UTF-8">
	<title>{% block title %}SIFACO - Sistema Integral de Farmacias Corporativas{% endblock %}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Sistema de gestión de farmacias corporativas - SIFACO" />
	<meta name="author" content="Sistema SIFACO" />
	<link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}">

	<!-- Estilos principales -->
	<link rel="stylesheet" href="{{ asset('css/preloader.min.css') }}">
	<link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
	<link rel="stylesheet" href="{{ asset('css/icons.min.css') }}">
	<link rel="stylesheet" href="{{ asset('css/app.min.css') }}">

	{% block stylesheets %}{% endblock %}

	{% block javascripts %}
	{% block importmap %}{{ importmap('app') }}{% endblock %}
	{% endblock %}
</head>

<body>
	<div id="layout-wrapper">
		<header id="page-topbar">
			<div class="navbar-header d-flex justify-content-between align-items-center p-3">
				<a href="{{ path('app_home_front') }}">
					<img src="{{ asset('images/logos/sifaco_logo.png') }}" alt="Logo SIFACO" height="40">
				</a>
				<div class="d-flex align-items-center">
					{% if app.user %}
					<span class="me-3">{{ app.user.username }}</span>
					<a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-danger">Salir</a>
					{% endif %}
				</div>
			</div>
		</header>

		<div class="d-flex">
			<!-- Sidebar -->
			<aside class="bg-light border-end" style="width: 220px; min-height: 100vh;">
				<nav class="nav flex-column p-3">
					<a class="nav-link" href="{{ path('app_home_front') }}">Inicio</a>
					<a class="nav-link" href="{{ path('app_secure_home') }}">Panel de Administración</a>
					<a class="nav-link" href="{{ path('empresa_index') }}">Empresas</a>
					<a class="nav-link" href="{{ path('sucursal_index') }}">Sucursales</a>
					<a class="nav-link" href="{{ path('usuario_index') }}">Usuarios</a>
				</nav>
			</aside>

			<!-- Contenido principal -->
			<div class="flex-grow-1">
				<main class="pt-4 px-4">
					{% block body %}{% endblock %}
				</main>

				<footer class="footer mt-auto py-3 bg-light border-top text-center">
					<small class="text-muted">&copy; {{ "now"|date("Y") }} SIFACO - Sistema Integral de Farmacias
						Corporativas</small>
				</footer>
			</div>
		</div>
	</div>

	<!-- Scripts base -->
	<script src="{{ asset('libs/jquery/jquery.min.js') }}"></script>
	<script src="{{ asset('libs/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
	<script src="{{ asset('libs/metismenu/metisMenu.min.js') }}"></script>
	<script src="{{ asset('libs/simplebar/simplebar.min.js') }}"></script>
	<script src="{{ asset('libs/node-waves/waves.min.js') }}"></script>
	<script src="{{ asset('js/app.js') }}"></script>
</body>

</html>