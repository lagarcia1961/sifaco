{% extends 'base_frontend.html.twig' %}

{# ✅ Fondo corregido para que no se deforme y funcione en todos los tamaños #}
{% block stylesheets %}
    <style>
        .auth-bg {
            background-image: url('/images/auth-fondo-nuevo.jpg') !important;
            background-position: center center !important;
            background-size: cover !important;
            background-repeat: no-repeat !important;
            background-color: #ffffff !important;
            min-height: 100vh;
        }

        @media (max-width: 768px) {
            .auth-bg {
                background-size: contain !important;
                background-position: top center !important;
            }
        }
    </style>
{% endblock %}

{% block login %}
    <div class="auth-page">
        <div class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-xxl-3 col-lg-4 col-md-5 d-flex align-items-center min-vh-100">
                    <div class="auth-full-page-content w-100 p-sm-5 p-4">
                        <div class="d-flex flex-column justify-content-center h-100">
                            <div class="mb-4 text-center">
                                <img src="{{ asset('images/logos/sifaco_logo.png') }}" alt="SIFACO-Sistema integral de Farmacias Corporativas" style="max-width: 100%;">
                            </div>
                            <div class="auth-content my-auto">
                                <div class="text-center">
                                    <h3 class="mb-3 text-primary text-bold" style="font-size:32px">Bienvenido</h3>
                                    <p class="text-primary text-bold" style="font-size:18px">Ingrese sus credenciales</p>
                                </div>
                                {% if error %}
                                    <div class="alert alert-danger mt-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                {% endif %}
                                <form method="post" class="mt-4">
                                    <div class="mb-3">
                                        <label class="form-label">Usuario</label>
                                        <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Contraseña</label>
                                        <div class="input-group auth-pass-inputgroup">
                                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required aria-label="Password" aria-describedby="password-addon">
                                            <button class="btn btn-light shadow-none ms-0" type="button" id="password-addon">
                                                <i class="mdi mdi-eye-outline"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                    <div class="mb-3">
                                        <button class="btn btn-primary w-100" type="submit">Iniciar sesión</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-9 col-lg-8 col-md-7 d-none d-md-block">
                    <div class="auth-bg d-flex"></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
